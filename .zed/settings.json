// Allows rust-analyzer to run differently since we're compiling in nightly for a 3ds.
{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "target": "armv6k-nintendo-3ds"
        },
        "check": {
          "overrideCommand": [
            "cargo",
            "3ds",
            "check",
            "--message-format=json"
          ]
        }
      }
    }
  }
}
